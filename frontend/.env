# Backend base URL.
#
# Leave BLANK to run fully offline against the bundled sample fleet in
# public/data/fleet.json. Set it to point the app at a real backend.
#
#   local backend   VITE_API_BASE_URL=http://localhost:8000/api/v1
#   deployed        VITE_API_BASE_URL=https://your-app.onrender.com/api/v1
#
# Personal overrides belong in .env.local, which git ignores.
VITE_API_BASE_URL=

# Days ahead that counts as "due soon" (see src/engine/rules.ts).
VITE_DUE_SOON_DAYS=30

VITE_DEV_AUTH=true
